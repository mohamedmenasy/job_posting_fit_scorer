# Copy to backend/.env. Never commit .env; never expose the key to the frontend.
EVALUATOR=typesafe               # or: fake (no API key needed; fixture-backed)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=                  # pinned model name from client.models.list(); never jev-latest
TYPESAFE_MAX_CONCURRENCY=4
TYPESAFE_TOKEN_BUDGET=24000
TYPESAFE_LOG_LEVEL=warning       # debug logs full request bodies, including your resume
EVALUATION_WORKERS=4
DATABASE_URL=sqlite:///./data/jobfit.db
LOG_LEVEL=info
